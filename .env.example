# Copy this file to .env.local and fill in your values

# NextAuth — generate secret with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_32

# Password to log in to the Linki UI
AUTH_PASSWORD=Password@123

# Internal secret for server-to-server API calls (e.g. the MCP server calling Linki's own
# /api/* routes over loopback). Generate separately with: openssl rand -base64 32
# MUST be different from NEXTAUTH_SECRET.
INTERNAL_API_SECRET=CHANGE_ME_different_secret_openssl_rand_base64_32

# Encryption key for sensitive data at rest (LinkedIn cookies, email passwords, API keys).
# Generate with: openssl rand -base64 32
# WARNING: Changing this key after data is written makes all encrypted data unrecoverable.
ENCRYPTION_KEY=CHANGE_ME_another_separate_secret

# MySQL database connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=linki
DB_POOL_LIMIT=10

# Set to "false" to show the browser window during LinkedIn automation (useful for debugging)
HEADLESS=true

# Optional: comma-separated email addresses that get super_admin role automatically
# SUPER_ADMIN_EMAILS=admin@example.com
